#!/bin/sh
set -e

# Remove the module before regenerating the image, then drop the module and
# firmware from an image that may already have been built.
#DEBHELPER#

if [ "$1" = remove ] || [ "$1" = purge ]; then
	if command -v update-initramfs >/dev/null 2>&1; then
		update-initramfs -u
	elif command -v dracut >/dev/null 2>&1; then
		dracut --force --kver "$(uname -r)"
	fi
fi

exit 0
